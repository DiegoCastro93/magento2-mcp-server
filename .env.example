# magento2-mcp-server — example configuration
#
# Copy for local development:  cp .env.example .env
#
# SECURITY: this repository lives under /var/www/html, a web document root.
# Do not put a real Magento integration token in a .env file here — a
# misconfigured vhost would serve it to anyone who asks. Supply real
# credentials through the `env` block of your MCP client configuration
# instead (see README). This file is for fixture-mode development.


# -----------------------------------------------------------------------------
# Data source
# -----------------------------------------------------------------------------
# fixture = serve canned JSON from MAGENTO_FIXTURES_DIR. No network, no token.
# http    = talk to a real Magento 2 Open Source instance.
#
# Guard: starting in fixture mode with MAGENTO_BASE_URL or MAGENTO_ACCESS_TOKEN
# set aborts at startup. Credentials configured but unused almost always mean
# someone forgot MAGENTO_MODE=http and is about to mistake canned data for
# their real store.
MAGENTO_MODE=fixture

# Required when MAGENTO_MODE=http. Leave empty in fixture mode (see guard above).
MAGENTO_BASE_URL=
MAGENTO_ACCESS_TOKEN=


# -----------------------------------------------------------------------------
# Inventory (MSI)
# -----------------------------------------------------------------------------
# Stock is read and written against a single fixed source. Multi-source
# selection is out of scope for v1.
MAGENTO_SOURCE_CODE=default
MAGENTO_STOCK_ID=1

# Fallback for products where use_config_manage_stock is true. Magento Open
# Source does not expose cataloginventory/item_options/manage_stock over REST,
# so get_product reports which of the two sources the value came from.
MAGENTO_DEFAULT_MANAGE_STOCK=true


# -----------------------------------------------------------------------------
# Write tools — DISABLED BY DEFAULT
# -----------------------------------------------------------------------------
# Comma-separated allowlist. Empty or unset means a read-only server: the write
# tools are never registered, so the model cannot see or call them.
#
# Known names: update_product_stock, add_order_comment
#
# An unrecognised name aborts startup rather than silently leaving a tool
# unregistered — a typo here would otherwise look exactly like the gate working
# correctly, which is the worst way for a permission boundary to fail.
MAGENTO_MCP_WRITE_TOOLS=


# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
MAGENTO_TIMEOUT_MS=10000
MAGENTO_FIXTURES_DIR=./fixtures
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# Note for CI
# -----------------------------------------------------------------------------
# The test suite runs entirely against fixtures. CI must not define
# MAGENTO_BASE_URL or MAGENTO_ACCESS_TOKEN: with the default fixture mode,
# either one would trip the conflict guard and fail the build.
